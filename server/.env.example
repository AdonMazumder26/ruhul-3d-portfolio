PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/ruhul_portfolio
# Comma-separate multiple origins if needed, e.g. http://localhost:5173,https://your-site.example
CLIENT_ORIGIN=http://localhost:5173

# --- Admin panel (optional; leave all three empty to disable /admin) ---
# Login email for the single admin account.
ADMIN_EMAIL=
# bcrypt hash of the admin password. Generate with: npm run admin:hash -- "your strong password"
ADMIN_PASSWORD_HASH=
# Random secret (32+ chars) used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# How long an admin session stays valid (days, 1-90). Default 7.
ADMIN_SESSION_DAYS=7
